         14,
         strategy.position_size > 0
         ? (
              activeSizingMode == "Lots"
              ? str.tostring(
                   activeSizingValue,
                   "#.##"
              ) +
                " Lots"
              : "$" +
                str.tostring(
                     activeSizingValue,
                     "#.##"
                )
         )
         : "-"
    )
    table.cell(
         dashboard,
         2,
         14,
         strategy.position_size < 0
         ? (
              activeSizingMode == "Lots"
              ? str.tostring(
                   activeSizingValue,
                   "#.##"
              ) +
                " Lots"
              : "$" +
                str.tostring(
                     activeSizingValue,
                     "#.##"
                )
         )
         : "-"
    )

